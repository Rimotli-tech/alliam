rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsAccount(accountId) {
      return request.auth != null && request.auth.uid == accountId;
    }
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    function isOrganizationMember(organizationId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.status == 'active';
    }
    function ownsOrganization(organizationId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/organizations/$(organizationId)).data.ownerUid == request.auth.uid;
    }
    function hasOrganizationPermission(organizationId, permission) {
      return ownsOrganization(organizationId) ||
        (isOrganizationMember(organizationId) &&
          get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.permissions[permission] == true);
    }

    match /accounts/{accountId} {
      allow read: if ownsAccount(accountId) || isAdmin();
      allow delete: if ownsAccount(accountId);
      allow create: if ownsAccount(accountId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role in ['pending', 'student', 'parent', 'organization'];
      allow update: if ownsAccount(accountId) &&
        request.resource.data.uid == resource.data.uid &&
        (request.resource.data.role in ['pending', 'student', 'parent', 'organization'] ||
          (request.resource.data.role == 'admin' && isAdmin()));

      match /{document=**} {
        allow read: if ownsAccount(accountId) || isAdmin();
        allow write: if ownsAccount(accountId);
      }
    }

    match /words/{wordId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /wordSets/{setId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /audioVersions/{versionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /organizations/{organizationId} {
      allow create: if request.auth != null &&
        request.resource.data.ownerUid == request.auth.uid;
      allow read: if isAdmin() || ownsOrganization(organizationId) ||
        isOrganizationMember(organizationId);
      allow update: if isAdmin() ||
        hasOrganizationPermission(organizationId, 'manageOrganization');
      allow delete: if isAdmin() || ownsOrganization(organizationId);

      match /members/{memberId} {
        allow read: if isAdmin() || ownsOrganization(organizationId) ||
          isOrganizationMember(organizationId);
        allow create: if (request.auth != null &&
          request.resource.data.uid == memberId &&
          memberId == request.auth.uid &&
            request.resource.data.role == 'owner' &&
            ownsOrganization(organizationId)) ||
          (hasOrganizationPermission(organizationId, 'manageMembers') &&
            request.resource.data.role != 'owner');
        allow update, delete: if isAdmin() ||
          (hasOrganizationPermission(organizationId, 'manageMembers') &&
            resource.data.role != 'owner');
      }

      match /learners/{learnerId} {
        allow read: if isAdmin() || isOrganizationMember(organizationId);
        allow create, update, delete: if isAdmin() ||
          hasOrganizationPermission(organizationId, 'manageLearners');
      }

      match /teams/{teamId} {
        allow read: if isAdmin() || isOrganizationMember(organizationId);
        allow create, update, delete: if isAdmin() ||
          hasOrganizationPermission(organizationId, 'manageTeams');
      }

      match /competitions/{competitionId} {
        allow read: if isAdmin() || isOrganizationMember(organizationId);
        allow create, update, delete: if isAdmin() ||
          hasOrganizationPermission(organizationId, 'manageCompetitions');
      }

      match /invitations/{invitationId} {
        allow read: if isAdmin() || isOrganizationMember(organizationId);
        allow create, update, delete: if isAdmin() ||
          hasOrganizationPermission(organizationId, 'manageMembers');
      }

      match /activity/{activityId} {
        allow read: if isAdmin() || isOrganizationMember(organizationId);
        allow create: if isAdmin() || isOrganizationMember(organizationId);
        allow update, delete: if false;
      }
    }

    match /players/{playerId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /friendCodes/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth != null &&
        (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
      allow write: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow write: if false;
    }

    match /teams/{teamId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if request.auth != null &&
        (resource.data.organizerUid == request.auth.uid || request.auth.uid in resource.data.participantUids);
      allow write: if false;
    }

    match /matchQueue/{playerId} {
      allow read: if request.auth != null && request.auth.uid == playerId;
      allow write: if false;
    }

    match /matchAssignments/{playerId} {
      allow read: if request.auth != null && request.auth.uid == playerId;
      allow write: if false;
    }

    match /matches/{matchId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.players;
      allow write: if false;
    }

    match /invitations/{invitationId} {
      allow read: if request.auth != null &&
        (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
      allow write: if false;
    }

    match /privateRooms/{code} {
      allow read: if request.auth != null &&
        (resource.data.ownerUid == request.auth.uid ||
          resource.data.joinedUid == request.auth.uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
